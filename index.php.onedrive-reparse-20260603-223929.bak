                        <td><?= h($svc['note']) ?></td>
                        <td><?php if ($base > 0): ?><button class="mini choose-service" type="button" data-group="<?= h($svc['group']) ?>" data-service="<?= h($svc['name']) ?>" data-base="<?= h($base) ?>">Chọn</button><?php endif; ?></td>
