# =========================================================================================
# ENV TEMPLATE - DIEN MAY HIEU
# Copy to .env on the server, then fill real secrets there.
# Never commit the real .env file.
# =========================================================================================

# === APP ===
APP_DEBUG=false
APP_URL=https://dienmayhieu.com
CRON_SECRET=

# === DATABASE ===
# Canonical keys only. Do not add DB_USER_BAOCAO, DB_PASS_BAOCAO,
# DB_USER_SHIPPER, or DB_PASS_SHIPPER aliases back into application code.
# DB_NAME must exactly match the cPanel database name, including letter case.
# DB_USER must be assigned to that DB in cPanel MySQL Databases.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# === TELEGRAM BOT TOKENS ===
# Anh Thien - goi tho
BOT_WORKER_TOKEN=
# Anh Thien - bao cao / AI
BOT_REPORT_TOKEN=

# Numeric group/user chat ids are recommended.
WORKER_CHAT_ID=
BOSS_CHAT_ID=-1003754511106
BOSS_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=648065292
INITIAL_WORKER_TELEGRAM_ID=8729878070

# === AI / PAYMENT ===
# Local Ollama is the first provider for POST /api_master.php?action=anh_thien_chat.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_CONNECT_TIMEOUT=2
OLLAMA_TIMEOUT=60
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
GEMMA_TEMPERATURE=0.30
GEMMA_MAX_OUTPUT_TOKENS=520
GEMMA_THINKING_LEVEL=

# Remote fallbacks used when Ollama is unavailable.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
HF_TOKEN=
HF_TEXT_MODEL=google/gemma-2-9b-it
AI_ASSISTANT_NAME=Anh Thiên
ANH_THIEN_SYSTEM_PROMPT=
SEPAY_API_KEY=

# === ADMIN ===
# Prefer ADMIN_PASS_HASH generated by password_hash().
ADMIN_PASS=
ADMIN_PASS_HASH=

# === BO CONG THUONG REPORT API ===
# Generate with: php scripts/generate_bct_credentials.php
# The password hash is storage-only and is never accepted as a login secret.
BCT_REPORT_USER=qltmdt@moit.gov.vn
BCT_REPORT_PASS_HASH=
BCT_REPORT_API_KEY_HASH=
BCT_COMPANY_NAME=DIEN MAY HIEU
BCT_TAX_CODE=
BCT_WEBSITE=https://dienmayhieu.com
BCT_REPORT_MAX_DAYS=370
BCT_REPORT_SESSION_TTL=3600
BCT_INPUT_PDF_MAX_MB=20

# === COMPANY / SALES INVOICE ===
COMPANY_NAME=DIEN MAY HIEU
COMPANY_TAX_CODE=1402228630
COMPANY_ADDRESS=166, Ap Binh Thanh 1, Xa Lap Vo, Tinh Dong Thap
COMPANY_PHONE=0979.553.289
COMPANY_EMAIL=
COMPANY_WEBSITE=https://dienmayhieu.com
SERVICE_CENTER_LAT=10.357422
SERVICE_CENTER_LNG=105.522124
SERVICE_RADIUS_KM=15
# One loyalty point is earned for each configured VND amount paid.
LOYALTY_VND_PER_POINT=10000

# === BANK / VIETQR ===
VNB_ACC=
VNB_BIN=ICB
VNB_HOLDER=
# Optional HTTPS/deep-link templates. Supported placeholders: {amount}, {code}, {worker_id}
BANK_PAYMENT_URL=
MOMO_PAYMENT_URL=

# Optional MoMo merchant integration. When configured, the worker button creates
# a signed payment link and the verified IPN automatically settles/unlocks debt.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet
MOMO_CREATE_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://dienmayhieu.com/?payment=momo
