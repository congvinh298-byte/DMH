datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  passwordPin   String?  // 6-digit PIN, default '123456' handled in logic
  isFirstLogin  Boolean  @default(true)
  name          String?
  role          Role     @default(CUSTOMER)
  
  // Geo-Location
  latitude      Float?
  longitude     Float?
  address       String?
  
  // Technician specific metrics
  dailyEarnings Float    @default(0.0)
  starRating    Float    @default(5.0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  orders        Order[]
  repairs       DispatchOrder[] @relation("TechnicianOrders")
  requests      DispatchOrder[] @relation("CustomerRequests")
  reviews       Review[]        @relation("TechnicianReviews")
}

enum Role {
  CUSTOMER
  ADMIN
  TECHNICIAN
  PARTNER
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  orderItems  OrderItem[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  items     OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model DispatchOrder {
  id           Int            @id @default(autoincrement())
  customerId   Int
  customer     User           @relation("CustomerRequests", fields: [customerId], references: [id])
  technicianId Int?
  technician   User?          @relation("TechnicianOrders", fields: [technicianId], references: [id])
  issueDetails String
  
  // Job Location
  latitude     Float?
  longitude    Float?
  address      String?
  
  status       DispatchStatus @default(PENDING)
  scheduledFor DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum DispatchStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Review {
  id           Int      @id @default(autoincrement())
  technicianId Int
  technician   User     @relation("TechnicianReviews", fields: [technicianId], references: [id])
  rating       Int      // 1 to 5
  comment      String?
  createdAt    DateTime @default(now())
}
